{
  "name": "django-gc-docs",
  "repository": "git@github.com:RDDLab/Django-GC.git",
  "author": "Raman Marozau <r.morozov@rdd-lab.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "docs:dev": "node scripts/docs-dev.mjs",
    "docs:dev:en": "docusaurus start --port 3100",
    "docs:dev:ru": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-ru docusaurus start --port 3101 --locale ru --no-open",
    "docs:build": "docusaurus build",
    "docs:serve": "docusaurus serve",
    "docs:clear": "docusaurus clear && rm -rf .docusaurus-ru",
    "docs:write-translations": "docusaurus write-translations"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~7.0.2"
  }
}
